# --- Database ---
DATABASE_URL=postgres://pontocego:pontocego_dev@127.0.0.1:5432/pontocego
POSTGRES_PASSWORD=pontocego_dev

# --- Admin sessions ---
# 64+ random hex chars; used to HMAC session tokens
SESSION_SECRET=change-me

# --- SMTP (stage 3 alerting) ---
# Works with any SMTP provider (Gmail app password, Resend, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=alerts@pontocego.local
ALERT_TO=

# --- Site ---
# Canonical public origin: canonical URLs, sitemap, OG tags all point here.
# Other hostnames serving the same app (preview.pontocego.app) get
# X-Robots-Tag: noindex from the middleware.
SITE_URL=https://pontocego.app
PUBLIC_INDEXING_ENABLED=false
CLASSIFY_PROMPT_VERSION=v1
GEMINI_API_KEY=
GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite
GEMINI_FLASH_MODEL=gemini-2.5-flash
# Enable only when direct access is blocked and a trusted reverse proxy
# overwrites forwarding headers.
TRUST_PROXY_HEADERS=0

# --- Worker ---
# Identify ourselves politely to outlets
USER_AGENT=PontoCegoBot/0.1 (+https://pontocego.app; news aggregator; contato@pontocego.app)

# --- Stage 4: classification (spec §3.1/§4) ---
# Without the key the classifier idles (log-and-skip); everything else runs.
ANTHROPIC_API_KEY=
# Pinned model id — never float on "latest" (spec §3.1). Haiku-tier for volume.
CLASSIFY_MODEL_ID=claude-haiku-4-5-20251001
# Per-day spend ceiling in USD; classification pauses when reached.
CLASSIFY_DAILY_USD_CEILING=6
# Articles per Message Batch submission.
CLASSIFY_BATCH_SIZE=100

# --- Calibration preview (spec §10 private period) ---
# When set, the public pages are locked behind /?convite=<code>.
# Leave empty to open the site (the eventual launch switch).
PREVIEW_ACCESS_CODE=

# --- Patrono (Mercado Pago Checkout Pro) ---
# Leave empty and /patrono renders the "em breve" placeholder.
# A token starting with TEST- routes checkout to the sandbox init_point.
MERCADOPAGO_ACCESS_TOKEN=

# --- Newsletter (spec 2026-09-04): daily 07:00 BRT via Resend ---
NEWSLETTER_ENABLED=0
NEWSLETTER_SEND_HOUR=7
RESEND_API_KEY=
